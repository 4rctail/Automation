{
  "manifest_version": 3,
  "name": "AI Browser Operator",
  "version": "0.1.0",
  "description": "AI-assisted browser automation for dynamic web apps.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://ads.tiktok.com/*",
    "https://tiktok.com/*",
    "https://*.tiktok.com/*",
    "file:///*",
    "http://localhost/*",
    "http://localhost:*/*",
    "http://127.0.0.1/*",
    "http://127.0.0.1:*/*",
    "http://localhost:8787/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ads.tiktok.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*",
        "file:///*",
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "src/shared/selectors.js",
        "src/content/dom-scanner.js",
        "src/content/action-engine.js",
        "src/content/prompt-parser.js",
        "src/content/content-main.js"
      ],
      "css": [
        "src/content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/overlay.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_title": "AI Browser Operator"
  },
  "commands": {
    "toggle-operator": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle AI Browser Operator overlay"
    }
  }
}
